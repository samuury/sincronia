# Copie este arquivo para `.env` e preencha com os valores reais.
# O `.env` está no .gitignore — nunca commite chaves de verdade.

# ============================================================
# CLIENT (browser) — embarcadas no bundle JS pelo Vite.
# Qualquer valor aqui é PÚBLICO. Não coloque segredos reais.
# ============================================================
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"

# ATENÇÃO: service role no client = bypass total de RLS.
# Hoje é usada por /admin no browser. Remover quando /admin virar server-side.
VITE_SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# ============================================================
# SERVER (server functions / runtime Node) — nunca chegam ao browser.
# ============================================================
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Google AI Studio — https://aistudio.google.com/apikey
GEMINI_API_KEY="your-gemini-api-key"

# Model id válido (ex: gemini-2.5-flash, gemini-2.0-flash-lite).
GEMINI_MODEL="gemini-2.5-flash"

# ============================================================
# CLAUDE (Tier "smart" - Geração do material didático profundo)
# ============================================================
CLAUDE_API_KEY="your-anthropic-key"
CLAUDE_MODEL="claude-3-5-sonnet-20241022"
