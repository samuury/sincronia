# Copie este arquivo para `.env` e preencha com os valores reais.
# O `.env` está no .gitignore — nunca commite chaves de verdade.

# ============================================================
# CLIENT (browser) — embarcadas no bundle JS pelo Vite.
# Qualquer valor aqui é PÚBLICO. Não coloque segredos reais.
# ============================================================
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"

# ATENÇÃO: service role no client = bypass total de RLS.
# Hoje é usada por /admin no browser. Remover quando /admin virar server-side.
VITE_SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# ============================================================
# SERVER (server functions / runtime Node) — nunca chegam ao browser.
# ============================================================
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# ============================================================
# CLAUDE / ANTHROPIC (Tiers "fast" e "smart")
# Obtenha em: https://console.anthropic.com/
# Suporta múltiplas chaves separadas por vírgula para balanceamento.
# ============================================================
CLAUDE_API_KEY="your-anthropic-key"

# Tier "smart" — Geração do material didático profundo, capítulos e relatórios
CLAUDE_MODEL="claude-3-5-sonnet-20241022"

# Tier "fast" — Micro-diagnóstico, exercícios, outline, estimativas e extração
CLAUDE_FAST_MODEL="claude-haiku-4-5-20251001"
