# syntax=docker/dockerfile:1.7
# Imagem de desenvolvimento — hot reload via volume mount no docker-compose.

FROM node:22-alpine
WORKDIR /app

# Instala deps a partir do lockfile. O código vem via volume (docker-compose),
# então só o package*.json é COPIADO aqui — assim o cache do layer só invalida
# quando dependências mudam.
COPY package.json package-lock.json ./
RUN npm ci

ENV DOCKER=true
ENV CHOKIDAR_USEPOLLING=true

EXPOSE 5173

CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
